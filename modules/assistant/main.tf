resource "codemie_assistant" "this" {
  name                          = var.name
  description                   = var.description
  system_prompt                 = var.system_prompt
  project                       = var.project
  icon_url                      = var.icon_url
  llm_model_type                = var.llm_model_type
  enable_image_generation       = var.enable_image_generation
  image_generation_model        = var.image_generation_model
  conversation_starters         = var.conversation_starters
  shared                        = var.shared
  is_react                      = var.is_react
  is_global                     = var.is_global
  agent_mode                    = var.agent_mode
  plan_prompt                   = var.plan_prompt
  slug                          = var.slug
  temperature                   = var.temperature
  top_p                         = var.top_p
  tools_tokens_size_limit       = var.tools_tokens_size_limit
  smart_tool_selection_enabled  = var.smart_tool_selection_enabled
  assistant_ids                 = var.assistant_ids
  enabled_builtin_subagents     = var.enabled_builtin_subagents
  skill_ids                     = var.skill_ids
  type                          = var.type
  categories                    = var.categories
  source_assistant_id           = var.source_assistant_id
  skip_integration_validation   = var.skip_integration_validation

  context                       = var.context
  toolkits                      = var.toolkits
  mcp_servers                   = var.mcp_servers
  hedging_config                = var.hedging_config
  interactive_features          = var.interactive_features
  bedrock                       = var.bedrock
  bedrock_agentcore_runtime     = var.bedrock_agentcore_runtime
  agent_card                    = var.agent_card
  prompt_variables              = var.prompt_variables
  custom_metadata               = var.custom_metadata
  guardrail_assignments         = var.guardrail_assignments
}
